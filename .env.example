# ─────────────────────────────────────────────────────────────────────────
# fullKONK_> — environment configuration reference
# ─────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: fullKONK_> is a 100% client-side Obsidian plugin. It has no
# server component and never reads a `.env` file at runtime inside Obsidian.
#
# All provider API keys (Groq, DeepSeek, Google Gemini, Cerebras, SambaNova,
# OpenRouter, NVIDIA NIM, GitHub Models, HuggingFace) are entered by the user
# directly in Obsidian via Settings → fullKONK_>, and are persisted by
# Obsidian's own Plugin#saveData() API inside:
#
#   <your-vault>/.obsidian/plugins/fullkonk/data.json
#
# That file lives only inside your local vault and is never sent anywhere
# except directly to the provider you configured, straight from the plugin's
# `fetch()` calls (see src/orchestrator.ts). Do NOT put real API keys in this
# file — it exists purely to document the variables consumed by the LOCAL
# DEVELOPMENT and CI tooling (npm scripts / Jest), never by the bundled
# `main.js` that ships to end users.
#
# Usage: `cp .env.example .env` and adjust values for local development.
# `.env` is git-ignored and is NOT loaded by the esbuild bundle or by
# Obsidian; it's a convenience for engineers who want to export these values
# into their shell before running npm scripts.

# ── Local dev / CI tooling only ─────────────────────────────────────────────

# Verbosity of fullKONK_>'s internal leveled logger (src/utils/logger.ts) when
# the *source* runs under plain Node.js — i.e. during `npm run dev` (esbuild
# watch) and `npm test` (Jest). Silently ignored inside real Obsidian, which
# has no `process.env`.
# One of: silent | error | warn | info | debug
FULLKONK_LOG_LEVEL=warn

# Standard CI flag. Automatically set to "true" by GitHub Actions (see
# .github/workflows/ci.yml). When true, Jest runs with `--ci` semantics
# (no interactive watch mode, deterministic snapshot handling) and esbuild
# skips inline sourcemaps in favor of a minified production bundle.
CI=false

# Node environment. Only used by tooling (ts-jest, esbuild) to select
# sensible defaults; never inspected by plugin runtime code.
# One of: development | test | production
NODE_ENV=development

# ── Optional: manual end-to-end smoke testing against real providers ───────
# These are NEVER read by the plugin itself and are not required to build,
# lint, or test fullKONK_>. They only exist so a contributor can write a
# throwaway local Node script (e.g. `node scripts/smoke-test.mjs`, not
# included) to sanity-check `src/orchestrator.ts` against a live provider
# without hand-editing source files. Leave these blank unless you are doing
# that kind of manual verification, and NEVER commit real values.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
GITHUB_MODELS_TOKEN=
HUGGINGFACE_API_KEY=
